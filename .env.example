# Sem esta variável o sistema usa SQLite em data/empenho.db (desenvolvimento).
# Com ela, usa PostgreSQL — obrigatório na Vercel, cujo disco é efêmero.
#
# Neon (o Postgres do marketplace da Vercel) entrega a URL pronta:
DATABASE_URL=postgres://usuario:senha@host.neon.tech/neondb?sslmode=require

# Opcional: tamanho do pool. Em serverless, poucos por instância.
# PGPOOL_MAX=3
